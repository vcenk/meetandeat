# Production canonical URL — used by metadataBase, sitemap, robots, JSON-LD.
# Override per environment (preview deploys should set their own URL).
NEXT_PUBLIC_SITE_URL=https://meetandeat.ca

# Google Search Console verification meta tag (the content="..." value).
# Find it at https://search.google.com/search-console under "HTML tag" verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
